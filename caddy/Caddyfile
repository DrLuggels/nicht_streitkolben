# Globale Optionen
{
	email admin@nicht-streitkolben.de
	# Bei Cloudflare-Proxy: DNS-Challenge nutzen, weil HTTP-Challenge sonst
	# durch CF abgefangen wird.
}

(security_headers) {
	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		-Server
	}
}

# Produktion: Domain mit Cloudflare-DNS-01-Challenge
nicht-streitkolben.de, www.nicht-streitkolben.de {
	encode zstd gzip
	import security_headers

	tls {
		dns cloudflare {env.CF_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
	}

	# www → apex Redirect
	@www host www.nicht-streitkolben.de
	redir @www https://nicht-streitkolben.de{uri} permanent

	reverse_proxy web:3000
}

# Lokale Entwicklung über Plain-HTTP (z. B. http://localhost oder :80 direkt)
:80 {
	encode zstd gzip
	reverse_proxy web:3000
}
