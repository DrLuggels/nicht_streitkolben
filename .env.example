# Kopiere zu .env und passe Werte an
POSTGRES_PASSWORD=kolben
SESSION_SECRET=please-change-this-in-production-very-long-key-at-least-32-chars

# Cloudflare API-Token mit Scopes:
#   Zone:Zone:Read    (für die Zone nicht-streitkolben.xyz)
#   Zone:DNS:Edit     (für die Zone nicht-streitkolben.xyz)
#   Zone:Zone Settings:Edit (optional, damit das Setup-Skript SSL-Modus setzen kann)
# Token erstellen: https://dash.cloudflare.com/profile/api-tokens
CF_API_TOKEN=
CF_ZONE_NAME=nicht-streitkolben.xyz
ORIGIN_IPV4=84.58.167.13
